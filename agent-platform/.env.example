# =============================================================================
# Agent Platform 环境变量样例
# 嵌套配置用双下划线分隔：<组>__<字段>（见 src/core/config.py）
# =============================================================================

ENVIRONMENT=development
DEBUG=false

# --- PostgreSQL --------------------------------------------------------------
DATABASE__DSN=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__ECHO=false

# --- Redis（缓存 / 会话 / 锁 / 事件流）-----------------------------------------
REDIS__URL=redis://localhost:6379/0
REDIS__MAX_CONNECTIONS=50
REDIS__EVENT_STREAM_TTL_SECONDS=3600

# --- 任务队列（ARQ，独立 Redis db）--------------------------------------------
QUEUE__REDIS_URL=redis://localhost:6379/1
QUEUE__JOB_TIMEOUT_SECONDS=1800
QUEUE__MAX_TRIES=3

# --- 安全 ---------------------------------------------------------------------
# 生产环境必须更换，并通过 Secret 管理注入
SECURITY__API_KEY_PEPPER=dev-pepper-change-me
SECURITY__JWT_ALGORITHM=HS256
SECURITY__JWT_SECRET=dev-secret-change-me
# RS256 时改用：
# SECURITY__JWT_ALGORITHM=RS256
# SECURITY__JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# SECURITY__JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
SECURITY__JWT_ISSUER=agent-platform
SECURITY__JWT_AUDIENCE=agent-platform
SECURITY__JWT_TTL_SECONDS=3600
SECURITY__INJECTION_BLOCK_THRESHOLD=0.8

# --- LLM 接入 -----------------------------------------------------------------
LLM__OPENAI_API_KEY=
# LLM__OPENAI_BASE_URL=https://api.openai.com/v1
LLM__ANTHROPIC_API_KEY=
# vLLM（OpenAI-compatible，经 litellm 接入）
# LLM__VLLM_BASE_URL=http://vllm:8000/v1
# LLM__VLLM_API_KEY=
LLM__DEFAULT_MODEL=openai:gpt-4o-mini
LLM__EMBEDDING_MODEL=text-embedding-3-small
LLM__EMBEDDING_DIMENSION=1536
# 重试与熔断
LLM__RETRY__MAX_ATTEMPTS=3
LLM__RETRY__BASE_DELAY_SECONDS=0.5
LLM__RETRY__MAX_DELAY_SECONDS=8.0
LLM__CIRCUIT_BREAKER__FAILURE_THRESHOLD=5
LLM__CIRCUIT_BREAKER__RECOVERY_SECONDS=30.0

# --- 可观测性 -------------------------------------------------------------------
OBSERVABILITY__SERVICE_NAME=agent-platform
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__JSON_LOGS=true
# OBSERVABILITY__OTLP_ENDPOINT=http://otel-collector:4317
OBSERVABILITY__TRACE_SAMPLE_RATIO=1.0
